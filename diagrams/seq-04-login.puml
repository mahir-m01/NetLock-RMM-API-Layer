@startuml seq-04-login
' ============================================================
' SEQ-04: POST /auth/login - current alpha implementation
' ============================================================

title SEQ-04: POST /auth/login - issue JWT + httpOnly refresh cookie

autonumber

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequence {
  ArrowColor #2E7D32
  LifeLineBorderColor #1B5E20
  ParticipantBackgroundColor #E8F5E9
  ParticipantBorderColor #1B5E20
  ActorBackgroundColor #FFEFCD
  ActorBorderColor #AA6622
  NoteBackgroundColor #FFFDE7
  NoteBorderColor #AA8800
}

actor "Dashboard\n(Next.js)" as Dashboard
participant "AuthEndpoints\nPOST /auth/login\n[AllowAnonymous]" as AE
participant "AuthService" as Auth
participant "IUserRepository" as Users
participant "IPasswordHasher\nBCrypt" as Hasher
participant "IJwtService\nJwtService" as JWT
participant "IRefreshTokenRepository" as RT
database "controlit_users" as UDB
database "controlit_refresh_tokens" as RTDB

Dashboard -> AE: POST /auth/login\n{ email, password }\ncredentials: include
activate AE
AE -> Auth: LoginAsync(request, HttpContext)
activate Auth

== Lookup and account state ==

Auth -> Users: GetByEmailAsync(request.Email)
Users -> UDB: SELECT * FROM controlit_users\nWHERE email = lower(email)
UDB --> Users: user | null
Users --> Auth

alt user missing OR inactive
  Auth --> AE: UnauthorizedAccessException("Invalid credentials.")
  AE --> Dashboard: 401 Problem\n"Invalid credentials."
end

alt locked_until > UtcNow
  Auth --> AE: UnauthorizedAccessException("Account is temporarily locked. Try again later.")
  AE --> Dashboard: 401 Problem\n"Account is temporarily locked..."
end

== Password verification and lockout ==

Auth -> Hasher: Verify(request.Password, user.PasswordHash)
Hasher --> Auth: ok?

alt password invalid
  Auth -> Users: UpdateAsync(user)\nFailedLoginCount += 1\nif >= 5, LockedUntil = now + 30m
  Users -> UDB: UPDATE failed_login_count,\nlocked_until
  Auth --> AE: UnauthorizedAccessException("Invalid credentials.")
  AE --> Dashboard: 401 Problem\n"Invalid credentials."
end

== Success path ==

Auth -> Users: UpdateAsync(user)\nFailedLoginCount = 0\nLockedUntil = null\nLastLoginAt = now
Users -> UDB: UPDATE user
UDB --> Users

Auth -> JWT: IssueAccessToken(user)
JWT -> JWT: HS256 claims\nsub, email, role, jti\noptional tenant_id, assigned_clients\nexp = now + 900s
JWT --> Auth: accessToken

Auth -> Auth: rawRefresh = 32 random bytes\nbase64url
Auth -> Auth: refreshHash = SHA256(rawRefresh)
Auth -> RT: CreateAsync(RefreshToken)\nuser_id, token_hash, expires_at=now+7d,\ncreated_at, user_agent, ip_address
RT -> RTDB: INSERT
RTDB --> RT: id
RT --> Auth

Auth -> Auth: SetRefreshCookie(rawRefresh)\nHttpOnly; Secure; SameSite=Strict;\nMax-Age=7d
Auth --> AE: LoginResponse\naccessToken, expiresIn=900,\nuser summary incl mustChangePassword
deactivate Auth

AE --> Dashboard: 200 OK\nbody + Set-Cookie refresh_token
deactivate AE

note right of Dashboard
  Frontend stores access token only in memory.
  Browser manages httpOnly refresh_token cookie.
  AuthProvider sets user from LoginResponse.user.
end note

alt user.MustChangePassword == true
  note right of Dashboard
    UI can route user to /account/change-password.
    API returns mustChangePassword in user summary.
  end note
end

@enduml
