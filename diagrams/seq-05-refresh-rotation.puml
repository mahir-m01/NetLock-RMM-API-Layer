@startuml seq-05-refresh-rotation
' ============================================================
' SEQ-05: POST /auth/refresh - current alpha rotation flow
' ============================================================

title SEQ-05: POST /auth/refresh - refresh rotation + replay revocation

autonumber

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequence {
  ArrowColor #2E7D32
  LifeLineBorderColor #1B5E20
  ParticipantBackgroundColor #E8F5E9
  ParticipantBorderColor #1B5E20
  ActorBackgroundColor #FFEFCD
  ActorBorderColor #AA6622
  NoteBackgroundColor #FFFDE7
  NoteBorderColor #AA8800
}

actor "Dashboard / Browser" as Dashboard
participant "AuthEndpoints\nPOST /auth/refresh\n[AllowAnonymous]" as AE
participant "AuthService" as Auth
participant "IRefreshTokenRepository" as RT
participant "IUserRepository" as Users
participant "IJwtService" as JWT
database "controlit_refresh_tokens" as RTDB
database "controlit_users" as UDB

Dashboard -> AE: POST /auth/refresh\nCookie: refresh_token=<raw>\ncredentials: include
activate AE

alt cookie missing
  AE --> Dashboard: 401 Problem\n"Refresh token cookie missing."
end

AE -> Auth: RefreshAsync(raw, HttpContext)
activate Auth
Auth -> Auth: hash = SHA256(raw)
Auth -> RT: GetByHashAsync(hash)
RT -> RTDB: SELECT * WHERE token_hash=@hash
RTDB --> RT: stored | null
RT --> Auth

alt stored missing OR expired
  Auth --> AE: UnauthorizedAccessException\n"Refresh token is invalid or expired."
  AE --> Dashboard: 401 Problem
end

alt stored.RevokedAt has value
  Auth -> RT: RevokeAllForUserAsync(stored.UserId)
  RT -> RTDB: UPDATE controlit_refresh_tokens\nSET revoked_at=now\nWHERE user_id=@uid AND revoked_at IS NULL
  note right of Auth
    Replay detected. Current code revokes all
    active refresh tokens for this user.
  end note
  Auth --> AE: UnauthorizedAccessException\n"Refresh token has already been used. All sessions revoked."
  AE --> Dashboard: 401 Problem
end

== User check ==

Auth -> Users: GetByIdAsync(stored.UserId)
Users -> UDB: SELECT * FROM controlit_users WHERE id=@id
UDB --> Users: user | null
Users --> Auth

alt user missing OR inactive
  Auth --> AE: UnauthorizedAccessException
  AE --> Dashboard: 401 Problem
end

== Rotate ==

Auth -> Auth: rawNew = 32 random bytes\nbase64url
Auth -> Auth: hashNew = SHA256(rawNew)
Auth -> RT: CreateAsync(new RefreshToken)\nuser_id, token_hash, expires_at=now+7d,\ncreated_at, user_agent, ip_address
RT -> RTDB: INSERT
RTDB --> RT: newTokenId
RT --> Auth

Auth -> RT: RevokeAsync(stored.Id, newTokenId)
RT -> RTDB: UPDATE old row\nrevoked_at=now,\nreplaced_by_id=@newTokenId
RTDB --> RT

Auth -> Auth: SetRefreshCookie(rawNew)\nHttpOnly; Secure; SameSite=Strict;\nMax-Age=7d
Auth -> JWT: IssueAccessToken(user)
JWT --> Auth: new access token
Auth --> AE: LoginResponse\naccessToken, expiresIn=900, user summary
deactivate Auth

AE --> Dashboard: 200 OK\nnew access token + overwritten refresh cookie
deactivate AE

note right of Dashboard
  API client retries original request once after
  successful refresh. If refresh fails, it clears
  in-memory access token and routes to /login.
end note

@enduml
