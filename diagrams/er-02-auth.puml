@startuml er-02-auth-alpha
' ============================================================
' ER-02: ControlIT alpha - auth/API-owned tables and NetLock boundary
' Source checked against current ControlItDbContext and NetLock read repos.
' ============================================================

title ER-02: ControlIT-Owned controlit_* Tables + Read-Only NetLock References

!define PK <b><color:#B71C1C>PK</color></b>
!define FK <b><color:#0D47A1>FK</color></b>
!define U  <b><color:#1B5E20>U</color></b>

skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam class {
  BackgroundColor<<netlock>> #FFF8E1
  BorderColor<<netlock>> #AA8800
  BackgroundColor<<controlit>> #E8F5E9
  BorderColor<<controlit>> #1B5E20
  BackgroundColor<<auth>> #E3F2FD
  BorderColor<<auth>> #0D47A1
  BackgroundColor<<network>> #E0F7FA
  BorderColor<<network>> #006064
}

package "NetLock-owned (read-only via Dapper)" #FFF8E1 {
  class tenants <<netlock>> {
    + PK id : int
    guid : string
    name : string
    company : string
    description : string
  }

  class locations <<netlock>> {
    + PK id : int
    + FK tenant_id : int
    name : string
  }

  class devices <<netlock>> {
    + PK id : int
    + FK tenant_id : int
    + FK location_id : int
    access_key : string
    device_name : string
    platform : string
    operating_system : string
    agent_version : string
    ip_address_internal : string
    ip_address_external : string
    last_access : string
    authorized : int
    .. telemetry columns ..
  }

  class events <<netlock>> {
    + PK id : int
    + FK device_id : int
    date : string
    severity : string
    _event : string
    description : string
  }
}

package "ControlIT auth (EF Core - controlit_*)" #E3F2FD {
  class controlit_users <<auth>> {
    + PK id : int
    + U email : string(255)
    password_hash : string(72)
    role : int
    + FK tenant_id : int?
    assigned_clients : json?
    is_active : bool
    must_change_password : bool
    password_changed_at : datetime
    failed_login_count : int
    locked_until : datetime?
    created_at : datetime
    last_login_at : datetime?
  }

  class controlit_refresh_tokens <<auth>> {
    + PK id : int
    + FK user_id : int
    + U token_hash : string(64)
    expires_at : datetime
    revoked_at : datetime?
    + FK replaced_by_id : int?
    created_at : datetime
    user_agent : string(512)?
    ip_address : string(45)?
  }

  class controlit_password_reset_tokens <<auth>> {
    + PK id : int
    + FK user_id : int
    + U token_hash : string(64)
    expires_at : datetime
    used_at : datetime?
    created_at : datetime
  }
}

package "ControlIT audit/network maps (EF Core - controlit_*)" #E8F5E9 {
  class controlit_audit_log <<controlit>> {
    + PK id : bigint
    timestamp : datetime
    + FK tenant_id : int
    actor_key_id : string(16)
    actor_email : string(255)?
    action : string(64)
    resource_type : string(64)
    resource_id : string(255)?
    ip_address : string(45)?
    result : string(16)
    error_message : text?
  }

  class controlit_device_netbird_map <<network>> {
    + PK id : int
    + U device_id : int
    + U netbird_peer_id : string(255)
    netbird_ip : string(45)
    netbird_hostname : string(255)
    mapped_at : datetime
    mapped_by : string(255)
  }

  class controlit_tenant_netbird_group <<network>> {
    + PK id : int
    + U tenant_id : int
    + U netbird_group_id : string(255)
    netbird_group_name : string(255)
    isolation_policy_id : string(255)
    group_mode : string(32)
    controlit_managed : bool
    created_at : datetime
    updated_at : datetime
  }
}

tenants ||--o{ locations : has
tenants ||--o{ devices : has
locations ||--o{ devices : hosts
devices ||--o{ events : emits

controlit_users ||--o{ controlit_refresh_tokens : issues
controlit_users ||--o{ controlit_password_reset_tokens : requests
controlit_refresh_tokens ||--o{ controlit_refresh_tokens : replaced_by_id

tenants ||..o{ controlit_users : tenant_id nullable
tenants ||..o{ controlit_audit_log : tenant_id
devices ||..o| controlit_device_netbird_map : device_id
tenants ||..o| controlit_tenant_netbird_group : tenant_id

note bottom of controlit_users
  BootstrapUserSeeder creates one SuperAdmin when no users exist.
  Source: CONTROLIT_BOOTSTRAP_EMAIL and CONTROLIT_BOOTSTRAP_PASSWORD.
  Seeded/synced bootstrap user has must_change_password = true.
end note

note bottom of controlit_refresh_tokens
  Raw refresh token is never stored.
  token_hash is SHA-256 of 32 random bytes.
  Successful refresh creates a new row and sets old row revoked_at
  plus replaced_by_id. Replayed revoked token revokes all user tokens.
end note

note right of controlit_tenant_netbird_group
  group_mode:
  - managed: ControlIT-created group/policy
  - external: existing NetBird group bound to tenant
  - read_only: existing group, mutations blocked
end note

note top of tenants
  Production boundary:
  NetLock tables are pre-existing and read-only to ControlIT.
  EF Core DbContext contains only controlit_* DbSets.
end note

note right of controlit_device_netbird_map
  Device to NetBird peer mapping enriches dashboard,
  devices, command, and network views with NetBird IP/peer data.
end note

@enduml
