@startuml UC2-API-Layer-Alpha
' ============================================================
' UC-2: ControlIT.Api alpha - frontend-facing API layer
' Source checked against current code on dev branch.
' ============================================================

title UC-2: ControlIT.Api Alpha - REST API Layer Drill-Down

left to right direction

skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam usecase {
  BackgroundColor #DDEEFF
  BorderColor #336699
  ArrowColor #336699
  ActorBackgroundColor #FFEFCD
  ActorBorderColor #AA6622
}
skinparam rectangle {
  BackgroundColor #FAFAFA
  BorderColor #1a1a2e
  BorderThickness 2
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #AA8800
}

actor "Dashboard User" as User
actor "Next.js\nDashboard" as Web <<system>>
actor "Threat Actor\n[stolen token/cookie]" as Threat <<threat>>

User --> Web

rectangle "ControlIT.Api (ASP.NET Core Minimal APIs)" {
  package "0 - Auth and Session" #E8F5E9 {
    usecase "POST /auth/login" as UCLogin
    usecase "POST /auth/refresh" as UCRefresh
    usecase "POST /auth/logout" as UCLogout
    usecase "POST /auth/change-password" as UCChangePwd
    usecase "POST /auth/forgot-password" as UCForgotPwd
    usecase "POST /auth/reset-password" as UCResetPwd
    usecase "GET /auth/me" as UCMe
    usecase "Bootstrap first\nSuperAdmin from env" as UCBootstrap
    usecase "Refresh rotation\n+ replay revocation" as UCRotate
  }

  package "1 - JWT, RBAC, Tenant Scope" #ECEFF1 {
    usecase "Validate JWT\niss/aud/sig/lifetime" as UCJwt
    usecase "Resolve Actor\nfrom claims" as UCActor
    usecase "TenantContext\nall tenants vs own tenant" as UCTenantCtx
    usecase "Authorization policies" as UCPolicies
    usecase "Role ceiling\nno equal-or-higher management" as UCRoleCeiling
    usecase "TenantTargetResolver\n?targetTenantId" as UCTargetTenant
    usecase "Rate limit\napi + commands" as UCRate
  }

  package "2 - User Management" #E3F2FD {
    usecase "GET /users" as UCUsersList
    usecase "POST /users\nreturn generated password once" as UCUsersCreate
    usecase "PATCH /users/{id}" as UCUsersPatch
    usecase "DELETE /users/{id}\nsoft deactivate" as UCUsersDelete
    usecase "POST /users/{id}/force-password-reset" as UCForceReset
  }

  package "3 - NetLock Reads and Dashboard" #DDEEFF {
    usecase "GET /dashboard" as UCDashboard
    usecase "GET /dashboard/stream\nGET /sync/stream" as UCStream
    usecase "GET /devices\nGET /devices/{id}" as UCDevices
    usecase "GET /tenants\nGET /tenants/{id}" as UCTenants
    usecase "GET /events" as UCEvents
    usecase "GET /audit/logs" as UCAudit
    usecase "GET /health\nGET /admin/system-health" as UCHealth
    usecase "PushEventHub\nsnapshot + live tenant-filtered events" as UCPush
  }

  package "4 - Commands" #FFF3E0 {
    usecase "POST /commands/execute" as UCExec
    usecase "POST /commands/batch\nsequential fan-out" as UCBatch
    usecase "Validate batch request\nunique ids, max 25, shell allow-list" as UCBatchValid
    usecase "Audit command\nPENDING -> terminal result" as UCCmdAudit
    usecase "Publish command.status.updated" as UCCmdPush
  }

  package "5 - NetBird MVP" #DDEEEE {
    usecase "GET /network/groups" as UCGroups
    usecase "POST /network/tenant-group\nexternal/read_only" as UCBindGroup
    usecase "GET /network/peers\nGET /network/peers/{id}" as UCPeers
    usecase "GET /network/setup-keys\nredacted key" as UCSetupList
    usecase "POST /network/setup-keys\nraw key once" as UCSetupCreate
    usecase "DELETE /network/setup-keys/{id}" as UCSetupDelete
    usecase "POST /network/enrol" as UCEnrol
    usecase "POST/DELETE\n/network/peers/{peerId}/link" as UCLink
    usecase "PUT /network/peers/{id}\nDELETE /network/peer/{id}" as UCPeerMutate
    usecase "GET /network/summary" as UCNetSummary
    usecase "GET /network/routes\nGET /network/policies\nGET /network/events" as UCNetVisibility
  }
}

actor "MySQL\nNetLock read-only + controlit_*" as MySQL <<database>>
actor "NetLock RMM\npre-existing install" as NetLock <<system>>
actor "NetBird\nManagement API" as NetBird <<external>>
actor "Browser\nmemory access token\nhttpOnly refresh cookie" as Browser <<system>>

Web --> UCLogin
Web --> UCRefresh
Web --> UCLogout
Web --> UCChangePwd
Web --> UCMe
Web --> UCUsersList
Web --> UCUsersCreate
Web --> UCUsersPatch
Web --> UCDashboard
Web --> UCStream
Web --> UCDevices
Web --> UCTenants
Web --> UCEvents
Web --> UCAudit
Web --> UCExec
Web --> UCBatch
Web --> UCGroups
Web --> UCBindGroup
Web --> UCPeers
Web --> UCSetupList
Web --> UCSetupCreate
Web --> UCSetupDelete
Web --> UCNetSummary
Web --> UCNetVisibility
Web --> UCHealth
Threat --> UCRate

UCLogin ..> Browser : returns access token\nsets refresh cookie
UCRefresh ..> UCRotate : <<include>>
UCLogin ..> UCBootstrap : startup precondition

UCUsersCreate ..> UCRoleCeiling : <<include>>
UCUsersPatch ..> UCRoleCeiling : <<include>>
UCUsersDelete ..> UCRoleCeiling : <<include>>
UCForceReset ..> UCRoleCeiling : <<include>>

UCDevices ..> UCTenantCtx : <<include>>
UCTenants ..> UCTenantCtx : <<include>>
UCEvents ..> UCTenantCtx : <<include>>
UCAudit ..> UCTenantCtx : <<include>>
UCExec ..> UCTenantCtx : <<include>>
UCBatch ..> UCTenantCtx : <<include>>

UCPeers ..> UCTargetTenant : <<include>>
UCSetupList ..> UCTargetTenant : <<include>>
UCSetupCreate ..> UCTargetTenant : <<include>>
UCSetupDelete ..> UCTargetTenant : <<include>>
UCBindGroup ..> UCTargetTenant : <<include>>
UCNetSummary ..> UCTargetTenant : <<include>>

UCBatch ..> UCBatchValid : <<include>>
UCExec ..> UCCmdAudit : <<include>>
UCBatch ..> UCCmdAudit : <<include>>
UCExec ..> UCCmdPush : <<include>>
UCBatch ..> UCCmdPush : <<include>>
UCStream ..> UCPush : <<include>>
UCCmdPush ..> UCPush : publishes

UCJwt --> UCActor
UCActor --> UCTenantCtx
UCPolicies --> UCRoleCeiling
UCPolicies --> UCTenantCtx

UCLogin --> MySQL
UCRefresh --> MySQL
UCLogout --> MySQL
UCChangePwd --> MySQL
UCUsersList --> MySQL
UCUsersCreate --> MySQL
UCUsersPatch --> MySQL
UCUsersDelete --> MySQL
UCForceReset --> MySQL
UCDashboard --> MySQL
UCDevices --> MySQL
UCTenants --> MySQL
UCEvents --> MySQL
UCAudit --> MySQL
UCExec --> MySQL
UCBatch --> MySQL
UCBindGroup --> MySQL
UCLink --> MySQL

UCDashboard --> NetLock
UCDevices --> NetLock
UCExec --> NetLock
UCBatch --> NetLock
UCHealth --> NetLock

UCGroups --> NetBird
UCBindGroup --> NetBird
UCPeers --> NetBird
UCSetupList --> NetBird
UCSetupCreate --> NetBird
UCSetupDelete --> NetBird
UCEnrol --> NetBird
UCLink --> NetBird
UCPeerMutate --> NetBird
UCNetVisibility --> NetBird
UCNetSummary --> NetBird

note right of UCTargetTenant
  Elevated roles (SuperAdmin/CpAdmin):
  targetTenantId required for tenant-scoped
  NetBird operations.

  Scoped roles:
  targetTenantId omitted or equal to own tenant.
  Different tenant returns 403.
end note

note right of UCSetupCreate
  Raw setup key returned only by
  POST /network/setup-keys.
  List endpoint always returns "[redacted]".
end note

note bottom of UCBatch
  Batch validates request then executes same
  command path per device. Each item gets
  audit and command.status.updated push event.
end note

note bottom of NetLock
  Production boundary:
  NetLock is pre-existing vendor stack.
  ControlIT reads NetLock tables via Dapper
  and calls SignalR/Admin surfaces.
end note

@enduml
