@startuml uc3-netbird-operations
title UC3 - NetBird Operations
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam ArrowColor #334155
skinparam ActorBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorFontColor #0F172A
skinparam UsecaseBorderColor #0F766E
skinparam UsecaseBackgroundColor #CCFBF1
skinparam UsecaseFontColor #0F172A
skinparam RectangleBorderColor #0F172A
skinparam RectangleBackgroundColor #F8FAFC

actor "SuperAdmin/CpAdmin" as Admin
actor "ClientAdmin" as ClientAdmin
actor "Technician" as Technician
actor "Managed Device" as Device
actor "NetBird API" as NetBird
actor "NetLock Device Inventory" as NetLock

rectangle "ControlIT Network Page" #F0FDFA {
  usecase "Select target tenant" as SelectTenant
  usecase "Bind existing group\nexternal/read_only" as BindGroup
  usecase "Create managed tenant group\nwhen needed" as ManagedGroup
  usecase "Create setup key\nraw key once" as CreateKey
  usecase "List setup keys\nredacted" as ListKeys
  usecase "Install NetBird agent\nwith setup key" as InstallAgent
  usecase "List peers" as ListPeers
  usecase "Link peer to\nControlIT device" as LinkPeer
  usecase "Show NetBird IP\non dashboard/devices" as ShowIp
  usecase "View network summary" as Summary
}

Admin --> SelectTenant
Admin --> BindGroup
Admin --> CreateKey
Admin --> ListKeys
Admin --> ListPeers
Admin --> LinkPeer
Admin --> Summary

ClientAdmin --> ListKeys
ClientAdmin --> ListPeers
ClientAdmin --> Summary
Technician --> Summary
Device --> InstallAgent

BindGroup ..> SelectTenant : <<include>>
CreateKey ..> SelectTenant : <<include>>
ListKeys ..> SelectTenant : <<include>>
ListPeers ..> SelectTenant : <<include>>
LinkPeer ..> SelectTenant : <<include>>
Summary ..> SelectTenant : <<include>>
ManagedGroup ..> CreateKey : <<extend>> no group exists
InstallAgent ..> CreateKey : <<include>> setup key
LinkPeer ..> ListPeers : <<include>>
ShowIp ..> LinkPeer : <<extend>> after mapping
ListKeys ..> CreateKey : <<extend>> redacted after create

BindGroup --> NetBird
ManagedGroup --> NetBird
CreateKey --> NetBird
ListKeys --> NetBird
InstallAgent --> NetBird
ListPeers --> NetBird
Summary --> NetBird
LinkPeer --> NetLock
ShowIp --> NetLock
@enduml
