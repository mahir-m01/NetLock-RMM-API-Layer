@startuml class-02-auth-alpha
' ============================================================
' CLASS-02: ControlIT.Api alpha - auth/API/frontend-facing model
' Source checked against current code on dev branch.
' ============================================================

title CLASS-02: ControlIT.Api Alpha - Auth, RBAC, Tenant, NetBird, Push, Commands

skinparam classFontSize 11
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #FAFAFA
  BorderColor #1a1a2e
  ArrowColor #336699
}

package "Domain.Models" #F3E5F5 {
  enum Role <<Enum>> {
    SuperAdmin = 0
    CpAdmin = 1
    ClientAdmin = 2
    Technician = 3
  }

  class ControlItUser {
    +Id : int
    +Email : string
    +PasswordHash : string
    +Role : Role
    +TenantId : int?
    +AssignedClientsJson : string?
    +IsActive : bool
    +MustChangePassword : bool
    +PasswordChangedAt : DateTime
    +FailedLoginCount : int
    +LockedUntil : DateTime?
    +CreatedAt : DateTime
    +LastLoginAt : DateTime?
  }

  class RefreshToken {
    +Id : int
    +UserId : int
    +TokenHash : string
    +ExpiresAt : DateTime
    +RevokedAt : DateTime?
    +ReplacedById : int?
    +CreatedAt : DateTime
    +UserAgent : string?
    +IpAddress : string?
  }

  class PasswordResetToken {
    +Id : int
    +UserId : int
    +TokenHash : string
    +ExpiresAt : DateTime
    +UsedAt : DateTime?
    +CreatedAt : DateTime
  }

  class DeviceNetbirdMap {
    +Id : int
    +DeviceId : int
    +NetbirdPeerId : string
    +NetbirdIp : string
    +NetbirdHostname : string
    +MappedAt : DateTime
    +MappedBy : string
  }

  class TenantNetbirdGroup {
    +Id : int
    +TenantId : int
    +NetbirdGroupId : string
    +NetbirdGroupName : string
    +IsolationPolicyId : string
    +GroupMode : string
    +ControlItManaged : bool
    +CreatedAt : DateTime
    +UpdatedAt : DateTime
  }
}

ControlItUser --> Role
RefreshToken --> ControlItUser : user_id
PasswordResetToken --> ControlItUser : user_id
RefreshToken --> RefreshToken : replaced_by_id

package "Domain.Interfaces" #E8F5E9 {
  interface IAuthService {
    +LoginAsync(request, ctx, ct) : Task<LoginResponse>
    +RefreshAsync(refreshToken, ctx, ct) : Task<LoginResponse>
    +LogoutAsync(userId, refreshToken, ct) : Task
    +ChangePasswordAsync(userId, request, ct) : Task
    +RequestPasswordResetAsync(email, ct) : Task
    +ResetPasswordAsync(request, ct) : Task
  }

  interface IUserRepository {
    +GetByEmailAsync(email, ct) : Task<ControlItUser?>
    +GetByIdAsync(id, ct) : Task<ControlItUser?>
    +ListAsync(ct) : Task<IReadOnlyList<ControlItUser>>
    +CreateAsync(user, ct) : Task<int>
    +UpdateAsync(user, ct) : Task
    +AnyExistsAsync(ct) : Task<bool>
  }

  interface IRefreshTokenRepository {
    +GetByHashAsync(tokenHash, ct) : Task<RefreshToken?>
    +CreateAsync(token, ct) : Task<int>
    +RevokeAsync(id, replacedById, ct) : Task
    +RevokeAllForUserAsync(userId, ct) : Task
  }

  interface IPasswordResetTokenRepository

  interface IJwtService {
    +AccessTokenLifetimeSeconds : int
    +IssueAccessToken(user) : string
    +ValidateToken(token) : ClaimsPrincipal?
  }

  interface IPasswordHasher {
    +Hash(plaintext) : string
    +Verify(plaintext, hash) : bool
  }

  interface IActorContext {
    +UserId : int
    +Email : string?
    +Role : Role
    +TenantId : int?
    +AssignedClients : IReadOnlyList<int>
    +IpAddress : string?
  }

  interface ITenantRepository
  interface IDeviceRepository
  interface IEventRepository
  interface INetLockAdminClient
  interface ICommandDispatcher {
    +DispatchAsync(deviceAccessKey, request, ct) : Task<CommandResult>
  }
  interface IAuditService

  interface INetbirdClient {
    +GetPeersAsync(ct) : Task<IEnumerable<NetbirdPeer>>
    +GetGroupsAsync(ct) : Task<IEnumerable<NetbirdGroup>>
    +CreateSetupKeyAsync(request, ct) : Task<NetbirdSetupKey>
    +DeleteSetupKeyAsync(keyId, ct) : Task
    +CreatePolicyAsync(request, ct) : Task<NetbirdPolicy>
  }

  interface INetbirdMappingRepository {
    +GetByDeviceIdAsync(deviceId, ct) : Task<DeviceNetbirdMap?>
    +GetByPeerIdAsync(peerId, ct) : Task<DeviceNetbirdMap?>
    +CreateMappingAsync(map, ct) : Task
    +DeleteByPeerIdAsync(peerId, ct) : Task
    +GetTenantGroupAsync(tenantId, ct) : Task<TenantNetbirdGroup?>
    +UpsertTenantGroupAsync(group, ct) : Task
  }

  interface IPushEventPublisher {
    +PublishAsync(evt, ct) : ValueTask
    +SubscribeAsync(scope, ct) : IAsyncEnumerable<PushEventEnvelope>
  }
}

package "Application" #ECEFF1 {
  class AuthService {
    -MaxFailedAttempts = 5
    -RefreshTokenLifetime = 7d
    -ResetTokenLifetime = 1h
    +LoginAsync(...)
    +RefreshAsync(...)
    +ChangePasswordAsync(...)
    -SetRefreshCookie(ctx, rawToken)
    -EnforcePasswordPolicy(password)
  }

  class RoleCeiling <<Policy>> {
    +CanManage(actorRole, targetRole) : bool
  }

  class HttpActorContext {
    +UserId / Email / Role / TenantId / AssignedClients / IpAddress
  }

  class TenantContext {
    +TenantId : int?
    +IsAllTenants : bool
    +IsResolved : bool
  }

  class TenantTargetResolver {
    +ResolveAsync(tenant, targetTenantId, tenants, ct) : Task<TenantResolutionResult>
  }

  class TenantNetworkService {
    +EnsureTenantGroupAsync(tenantId, ct) : Task<string>
    +BindTenantGroupAsync(tenantId, groupId, mode, ct) : Task<TenantNetbirdGroup>
    +GetTenantPeersAsync(tenantId, ct) : Task<IEnumerable<NetbirdPeer>>
  }

  class PushEventHub {
    -_subscribers : ConcurrentDictionary<Guid, Subscriber>
    +PublishAsync(evt, ct) : ValueTask
    +SubscribeAsync(scope, ct) : IAsyncEnumerable<PushEventEnvelope>
    +CanReceive(scope, evt) : bool
  }

  class ControlItFacade {
    +GetDevicesAsync(filter, tenant, ct)
    +GetDashboardSummaryAsync(tenant, ct)
    +GetDashboardPushSnapshotAsync(tenant, ct)
    +ExecuteCommandAsync(request, tenant, ct)
  }
}

IAuthService <|.. AuthService
AuthService --> IUserRepository
AuthService --> IRefreshTokenRepository
AuthService --> IPasswordResetTokenRepository
AuthService --> IJwtService
AuthService --> IPasswordHasher
HttpActorContext ..|> IActorContext
TenantContext --> IActorContext
TenantTargetResolver ..> TenantContext
TenantTargetResolver ..> ITenantRepository
TenantNetworkService --> INetbirdClient
TenantNetworkService --> INetbirdMappingRepository
PushEventHub ..|> IPushEventPublisher
ControlItFacade --> IDeviceRepository
ControlItFacade --> IEventRepository
ControlItFacade --> INetLockAdminClient
ControlItFacade --> ICommandDispatcher
ControlItFacade --> INetbirdMappingRepository
ControlItFacade --> IPushEventPublisher

package "Infrastructure" #DDEEFF {
  class JwtService {
    +AccessTokenLifetimeSeconds = 900
    +IssueAccessToken(user) : string
    +ValidateToken(token) : ClaimsPrincipal?
    +BuildValidationParameters(signingKey)
  }

  class BCryptPasswordHasher

  class BootstrapUserSeeder <<HostedService>> {
    +StartAsync(ct) : Task
    +SeedAsync(services, logger, forceSync, ct) : Task
  }

  class ControlItDbContext {
    +AuditLog : DbSet<AuditEntry>
    +Users : DbSet<ControlItUser>
    +RefreshTokens : DbSet<RefreshToken>
    +PasswordResetTokens : DbSet<PasswordResetToken>
    +DeviceNetbirdMaps : DbSet<DeviceNetbirdMap>
    +TenantNetbirdGroups : DbSet<TenantNetbirdGroup>
  }

  class UserRepository <<Repository>>
  class RefreshTokenRepository <<Repository>>
  class PasswordResetTokenRepository <<Repository>>
  class NetbirdMappingRepository <<Repository>>
  class MySqlDeviceRepository <<Repository>>
  class MySqlTenantRepository <<Repository>>
  class NetbirdApiClient <<Adapter>>
  class NetLockAdminClient <<Adapter>>
  class SignalRCommandDispatcher <<Adapter>>
}

IJwtService <|.. JwtService
IPasswordHasher <|.. BCryptPasswordHasher
IUserRepository <|.. UserRepository
IRefreshTokenRepository <|.. RefreshTokenRepository
IPasswordResetTokenRepository <|.. PasswordResetTokenRepository
INetbirdMappingRepository <|.. NetbirdMappingRepository
IDeviceRepository <|.. MySqlDeviceRepository
ITenantRepository <|.. MySqlTenantRepository
INetbirdClient <|.. NetbirdApiClient
INetLockAdminClient <|.. NetLockAdminClient
ICommandDispatcher <|.. SignalRCommandDispatcher
UserRepository --> ControlItDbContext
RefreshTokenRepository --> ControlItDbContext
PasswordResetTokenRepository --> ControlItDbContext
NetbirdMappingRepository --> ControlItDbContext
BootstrapUserSeeder --> IUserRepository
BootstrapUserSeeder --> IPasswordHasher

package "Endpoints" #FFECB3 {
  class AuthEndpoints {
    +POST /auth/login
    +POST /auth/refresh
    +POST /auth/logout
    +POST /auth/change-password
    +GET /auth/me
  }

  class UserEndpoints {
    +GET/POST/PATCH/DELETE /users
    +POST /users/{id}/force-password-reset
  }

  class DashboardEndpoints {
    +GET /dashboard
    +GET /dashboard/stream
    +GET /sync/stream
  }

  class CommandEndpoints {
    +POST /commands/execute
    +POST /commands/batch
  }

  class NetworkEndpoints {
    +GET /network/peers
    +POST /network/tenant-group
    +GET/POST/DELETE /network/setup-keys
    +POST /network/enrol
    +GET /network/summary
  }
}

AuthEndpoints ..> IAuthService
UserEndpoints ..> RoleCeiling
UserEndpoints ..> IUserRepository
DashboardEndpoints ..> ControlItFacade
DashboardEndpoints ..> IPushEventPublisher
CommandEndpoints ..> ControlItFacade
CommandEndpoints ..> IAuditService
NetworkEndpoints ..> TenantTargetResolver
NetworkEndpoints ..> TenantNetworkService
NetworkEndpoints ..> INetbirdClient

note right of RoleCeiling
  Actor may manage only lower-privilege roles.
  SuperAdmin cannot manage SuperAdmin.
  CpAdmin cannot manage CpAdmin or SuperAdmin.
end note

note bottom of TenantTargetResolver
  Elevated roles require targetTenantId for tenant-scoped
  NetBird operations. Scoped roles cannot choose another tenant.
end note

note right of PushEventHub
  Dashboard streams send snapshot first, then tenant-filtered
  live events. Tenantless events go to all subscribers.
end note

@enduml
