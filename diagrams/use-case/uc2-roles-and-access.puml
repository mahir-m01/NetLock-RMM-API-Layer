@startuml uc2-roles-and-access
title UC2 - Roles, Tenant Scope, Access Control
left to right direction
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
skinparam ArrowColor #334155
skinparam ActorBorderColor #334155
skinparam ActorBackgroundColor #E2E8F0
skinparam ActorFontColor #0F172A
skinparam UsecaseBorderColor #6D28D9
skinparam UsecaseBackgroundColor #EDE9FE
skinparam UsecaseFontColor #0F172A
skinparam RectangleBorderColor #0F172A
skinparam RectangleBackgroundColor #F8FAFC

actor "SuperAdmin" as SuperAdmin
actor "CpAdmin" as CpAdmin
actor "ClientAdmin" as ClientAdmin
actor "Technician" as Technician
actor "Threat Actor\nstolen token/cookie" as Threat

rectangle "Identity and Session" #ECFDF5 {
  usecase "Login" as Login
  usecase "Refresh token\nrotation" as Refresh
  usecase "Logout" as Logout
  usecase "Change password" as ChangePassword
  usecase "Reset password" as ResetPassword
}

rectangle "Authorization Controls" #EEF2FF {
  usecase "Validate JWT" as Jwt
  usecase "Resolve actor\nfrom claims" as Actor
  usecase "Apply tenant scope" as TenantScope
  usecase "Require targetTenantId\nfor elevated NetBird ops" as TargetTenant
  usecase "Block equal-or-higher\nrole management" as RoleCeiling
  usecase "Partition rate limits\nby actor/IP" as RateLimit
}

rectangle "Protected Operations" #FFF7ED {
  usecase "Manage users" as ManageUsers
  usecase "Read tenant data" as ReadTenant
  usecase "Execute commands" as Commands
  usecase "Manage NetBird tenant\nnetwork" as NetBirdOps
  usecase "Read audit logs" as Audit
}

SuperAdmin --> Login
CpAdmin --> Login
ClientAdmin --> Login
Technician --> Login

SuperAdmin --> ManageUsers
CpAdmin --> ManageUsers
SuperAdmin --> NetBirdOps
CpAdmin --> NetBirdOps
ClientAdmin --> NetBirdOps
Technician --> Commands
CpAdmin --> Commands
ClientAdmin --> ReadTenant
SuperAdmin --> Audit
CpAdmin --> Audit

Login ..> Jwt : issues
Refresh ..> Jwt : renews
Logout ..> Refresh : revokes
ChangePassword ..> Refresh : revokes all
ResetPassword ..> Refresh : revokes all

Refresh ..> Login : <<extend>>
Logout ..> Login : <<extend>>
ChangePassword ..> Login : <<extend>>
ResetPassword ..> Login : <<extend>>

ManageUsers ..> Jwt : <<include>>
ManageUsers ..> Actor : <<include>>
ManageUsers ..> RoleCeiling : <<include>>
ReadTenant ..> Jwt : <<include>>
ReadTenant ..> Actor : <<include>>
ReadTenant ..> TenantScope : <<include>>
Commands ..> Jwt : <<include>>
Commands ..> Actor : <<include>>
Commands ..> TenantScope : <<include>>
NetBirdOps ..> Jwt : <<include>>
NetBirdOps ..> Actor : <<include>>
NetBirdOps ..> TenantScope : <<include>>
Audit ..> Jwt : <<include>>
Audit ..> Actor : <<include>>
Audit ..> TenantScope : <<include>>
TargetTenant ..> NetBirdOps : <<extend>> elevated roles

Jwt --> Actor
Actor --> TenantScope
Threat --> RateLimit
Login ..> RateLimit : <<include>>
Commands ..> RateLimit : <<include>>
@enduml
